{
  "name": "@revenexx/tag-manager-nuxt",
  "version": "0.1.0",
  "description": "Consent-gated tag manager for Nuxt, built on @nuxt/scripts: loads the tags published in the revenexx Tag Manager only with the visitor's consent and maps one vendor-neutral theme event stream (GA4-style, plus B2B events, no personal data) onto GA4, GTM, Meta, etracker, HubSpot and more.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt4",
    "nuxt-scripts",
    "tag-manager",
    "consent",
    "privacy",
    "analytics",
    "ecommerce-tracking",
    "ga4",
    "google-tag-manager",
    "meta-pixel",
    "etracker",
    "hubspot",
    "matomo",
    "theme-events",
    "b2b",
    "revenexx"
  ],
  "homepage": "https://github.com/revenexx/tag-manager-nuxt#readme",
  "bugs": {
    "url": "https://github.com/revenexx/tag-manager-nuxt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenexx/tag-manager-nuxt.git"
  },
  "license": "MIT",
  "author": "revenexx",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./events": {
      "types": "./dist/events.d.mts",
      "import": "./dist/events.mjs"
    },
    "./contract/theme-events.schema.json": "./contract/theme-events.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      "events": [
        "./dist/events.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "contract",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxi prepare playground && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "nuxi prepare playground && vue-tsc --noEmit",
    "test:dist": "tsc -p test/dist/tsconfig.json",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "spec:check": "node scripts/spec-check.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4"
  },
  "peerDependencies": {
    "@nuxt/scripts": "^1.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@nuxt/eslint-config": "^1.0.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/scripts": "^1.3.12",
    "@types/node": "^22.19.21",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "happy-dom": "^20.0.0",
    "nuxt": "^4.2.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.26",
    "vue-tsc": "^2.2.0",
    "unbuild": "^3.5.0"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}
